// fuel_sanki_processor.cpp

#include "fuel_sanki_processor.h"
#include "pal_logger.h"

#define __TAG__          "SANKI   "
#define SANKI_LOG_EN     true

#define MLOG(fmt, ...)  LOG_MSG_INFO( SANKI_LOG_EN, fmt, ##__VA_ARGS__)
#define MLOGE(fmt, ...) LOG_MSG_ERROR(SANKI_LOG_EN, fmt, ##__VA_ARGS__)

// ---------------------------------------------------------------------------

void FuelSankiProcessor::reset()
{
    _internal  = InternalState::IDLE;
    _last_vol  = 0;
    _last_unit = 0;
    _last_total = 0;
    _notify_state(NOZZLE_IDLE);
}

void FuelSankiProcessor::push_frame(display_type_t /*type*/, const display_data_t &data)
{
    const bool pumping = data.flags.bits.start_stop != 0;

    switch (_internal)
    {
        // ── IDLE ─────────────────────────────────────────────────────────────
        case InternalState::IDLE:
            if (pumping && data.volume_l > 0) {
                MLOG("→ PUMPING  vol=%lu", (unsigned long)data.volume_l);
                _internal = InternalState::PUMPING;
                _notify_state(NOZZLE_PUMPING);
            }
            break;

        // ── PUMPING ──────────────────────────────────────────────────────────
        case InternalState::PUMPING:
            // Accumulate last known good values while fuel is flowing
            if (data.volume_l > 0)    _last_vol   = data.volume_l;
            if (data.unit_price > 0)  _last_unit  = data.unit_price;
            if (data.total_price > 0) _last_total = data.total_price;

            if (!pumping) {
                // Pump has stopped
                if (_last_vol > 0) {
                    MLOG("→ PUMPED  vol=%lu unit=%lu total=%lu",
                         (unsigned long)_last_vol,
                         (unsigned long)_last_unit,
                         (unsigned long)_last_total);

                    _notify_state(NOZZLE_PUMPED);

                    if (_on_pumped) {
                        _on_pumped(_last_vol, _last_unit, _last_total);
                    }
                } else {
                    MLOG("stop with zero volume — discarding");
                }

                // Reset for next transaction
                _last_vol   = 0;
                _last_unit  = 0;
                _last_total = 0;
                _internal   = InternalState::IDLE;
                _notify_state(NOZZLE_IDLE);
            }
            break;
    }
}

// ---------------------------------------------------------------------------

void FuelSankiProcessor::_notify_state(nozzle_state_t s)
{
    _state = s;
    if (_on_state) _on_state(s);
}
