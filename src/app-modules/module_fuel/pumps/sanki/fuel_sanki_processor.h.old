// fuel_sanki_processor.h
//
// Stateful frame processor for the Sanki 6-digit display protocol.
//
// FuelSankiProcessor receives a stream of display_data_t frames decoded
// from the DT board UART and emits two callbacks:
//
//   on_state  — nozzle_state_t transitions (IDLE → PUMPING → PUMPED → IDLE)
//   on_pumped — final transaction values once fueling is confirmed complete
//
// State machine (driven purely by display data flags):
//
//   IDLE:
//     frame.flags.start_stop == 1 && volume_l > 0  →  PUMPING  (notify PUMPING)
//
//   PUMPING:
//     accumulate last total_price, volume_l, unit_price each frame
//     frame.flags.start_stop == 0  →  if last_vol > 0:
//                                        notify PUMPED (with last values)
//                                      transition to IDLE  (notify IDLE)
//
// Usage:
//   FuelSankiProcessor proc;
//   proc.set_on_state ([](nozzle_state_t s)             { ... });
//   proc.set_on_pumped([](uint32_t v, uint32_t u, uint32_t t) { ... });
//   // for every decoded frame:
//   proc.push_frame(display_type, data);

#pragma once

#include "fuel_pump_types.h"   // display_type_t, display_data_t
#include "nozzle_event.h"      // nozzle_state_t
#include <functional>

class FuelSankiProcessor
{
public:
    using on_state_fn  = std::function<void(nozzle_state_t state)>;
    using on_pumped_fn = std::function<void(uint32_t vol_lx1000,
                                             uint32_t unit_pricex100,
                                             uint32_t total_pricex100)>;

    FuelSankiProcessor() = default;

    void set_on_state (on_state_fn  fn) { _on_state  = fn; }
    void set_on_pumped(on_pumped_fn fn) { _on_pumped = fn; }

    /** Push one decoded display_data_t frame into the state machine. */
    void push_frame(display_type_t type, const display_data_t &data);

    /** Force reset to IDLE (e.g. on config change or module stop). */
    void reset();

    nozzle_state_t state() const { return _state; }

private:
    enum class InternalState { IDLE, PUMPING };

    InternalState _internal = InternalState::IDLE;
    nozzle_state_t _state   = NOZZLE_IDLE;

    uint32_t _last_vol   = 0;
    uint32_t _last_unit  = 0;
    uint32_t _last_total = 0;

    on_state_fn  _on_state;
    on_pumped_fn _on_pumped;

    void _notify_state(nozzle_state_t s);
};
