#include <stdint.h>
#include <stdbool.h>
#include <string.h>
#include <stdlib.h>

#include "pal_http_server.h"
#include "pal_spiffs.h"

#include "pal_logger.h"
#include "hsys_task.h"
#include "hsys_event.h"

#include "app.h"
#include "utils/utils.hpp"

#define __TAG__  "APP_WEBS"

#define APP_WEB_SERVER_WIFI_READY           (0x1 << 0)
#define APP_WEB_SERVER_CONFIG_READY         (0x1 << 1)
#define APP_WEB_SERVER_SPIFFS_READY         (0x1 << 2)
#define APP_WEB_SERVER_EVENT_CLOUD_READY    (0x1 << 3)

typedef enum{
    aws_waiting_for_ready,
    aws_running,
}app_webserver_state_t;

static pal_http_server_handle_t _server = NULL;
static bool _is_server_started = false;

static fp_app_webserver_on_event_t _on_event = NULL;

static hsys_task_handle_t _app_webserver_main_task_handle;
static hsys_eventgroup_handle_t _app_webserver_events;
static bool _is_initialized = false;
static fp_wake_task_t _wake;
static void * _wake_context;
static app_webserver_state_t app_webserver_state = aws_waiting_for_ready;
static web_server_cb_t * aws_cb_table = NULL;

// Handler declarations
static int32_t handle_index(pal_http_request_t req, void* user_ctx);
static int32_t handle_styles_css(pal_http_request_t req, void* user_ctx);
static int32_t handle_device_configurations(pal_http_request_t req, void* user_ctx);
static int32_t handle_get_device_configurations(pal_http_request_t req, void* user_ctx);
static int32_t handle_set_device_configurations_post(pal_http_request_t req, void* user_ctx);
static int32_t handle_esp32_firmware_upload(pal_http_request_t req, 
    const char* filename, size_t offset, const uint8_t* data, size_t len, bool is_final, void* user_ctx);
static int32_t handle_esp32_firmware_complete(pal_http_request_t req, void* user_ctx);
static int32_t handle_esp07_firmware_upload(pal_http_request_t req,
    const char* filename, size_t offset, const uint8_t* data, size_t len, bool is_final, void* user_ctx);
static int32_t handle_esp07_firmware_complete(pal_http_request_t req, void* user_ctx);

static void _on_config_event(app_config_event_t event, void * arg);
static void _on_wifi_event(app_wifi_event_t event, void * arg);
static void _on_spiffs_event(app_spiffs_event_t event, void * arg);
static void _on_cloud_event(app_cloud_event_t event, void * arg);

void app_webserver_init(const app_webserver_init_t * p_webserver_init){

    LOG_MSG_DEBUG(LOG_EN, "Initializing Web Server...");

    if(p_webserver_init->fp_app_webserver_on_event == NULL){
        LOG_MSG_DEBUG(LOG_EN, "Sensor Null pointer reference, please check.., Critical Error");
        while(1);        
    }

    if(p_webserver_init->app_init.event_table == NULL){
        LOG_MSG_DEBUG(LOG_EN, "WIFI Null pointer reference, please check.., Critical Error");
        while(1);     
    }

    _on_event = p_webserver_init->fp_app_webserver_on_event;

    _app_webserver_events = hsys_event_group_create();
    if(_app_webserver_events == NULL){
        LOG_MSG_ERROR(LOG_EN, "Critical Error!. app_config_init: hsys_event_group_create failed");
        while (1);
    }
    
    if(NULL == p_webserver_init->app_init.fp_wake || NULL == p_webserver_init->app_init.wake_context){
        LOG_MSG_ERROR(LOG_EN, "Critical Error! : fp_wake is NULL");
        while (1);
    }

    if(NULL == p_webserver_init->cb_table){
        LOG_MSG_ERROR(LOG_EN, "Critical Error! : cb_table is NULL");
        while (1);
    }

    _wake = p_webserver_init->app_init.fp_wake;
    _wake_context = p_webserver_init->app_init.wake_context;

    p_webserver_init->app_init.event_table->on_config_event = _on_config_event;
    p_webserver_init->app_init.event_table->on_wifi_event = _on_wifi_event;
    p_webserver_init->app_init.event_table->on_spiffs_event = _on_spiffs_event;
    p_webserver_init->app_init.event_table->on_cloud_event = _on_cloud_event;

    aws_cb_table = p_webserver_init->cb_table;    

    _is_initialized = true;  
}

static void _on_cloud_event(app_cloud_event_t event, void * arg){

    switch(event){
        case APP_CLOUD_EVNT_NETWORK_CONFIG_READY:
        case APP_CLOUD_EVNT_NETWORK_CONFIG_FAILED_RETRING:
            if(_app_webserver_events){
                hsys_event_group_set_bits(_app_webserver_events, APP_WEB_SERVER_EVENT_CLOUD_READY);
                if(_wake){
                    LOG_MSG_DEBUG(LOG_EN, "Wake From Cloud");
                    _wake(_wake_context);
                }
            }
            break;
        default:
            break;
    }
}

static void _on_spiffs_event(app_spiffs_event_t event, void * arg){
    switch(event){
        case APP_SPIFFS_EVNT_SPIFFS_READY:
            if(_app_webserver_events){
                hsys_event_group_set_bits(_app_webserver_events, APP_WEB_SERVER_SPIFFS_READY);
                if(_wake){
                    LOG_MSG_DEBUG(LOG_EN, "Wake From SPIFFS");
                    _wake(_wake_context);
                }
            }
            break;
        default:
            break;
    }
}

static void _on_wifi_event(app_wifi_event_t event, void * arg){
    switch(event){
        case HSYS_WIFI_EVENT_STA_GOT_IP:
            if(_app_webserver_events){
                hsys_event_group_set_bits(_app_webserver_events, APP_WEB_SERVER_WIFI_READY);
                if(_wake){
                    LOG_MSG_DEBUG(LOG_EN, "Wake From WIFI");
                    _wake(_wake_context);
                }
            }
            break;
        case HSYS_WIFI_EVENT_AP_START:
            if(_app_webserver_events){
                hsys_event_group_set_bits(_app_webserver_events, APP_WEB_SERVER_WIFI_READY);
                if(_wake){
                    LOG_MSG_DEBUG(LOG_EN, "Wake From WIFI");
                    _wake(_wake_context);
                }
            }
            break;
        default:
            break;
    }
}

static void _on_config_event(app_config_event_t event, void * arg){
    switch(event){
        case APP_CONFIG_EVENT_LOADED:
            if(_app_webserver_events){
                hsys_event_group_set_bits(_app_webserver_events, APP_WEB_SERVER_CONFIG_READY);
                if(_wake){
                    LOG_MSG_DEBUG(LOG_EN, "Wake From Config");
                    _wake(_wake_context);
                }
            }
            break;
        default:
            break;
    }
}

void app_webserver_run(){

    if(!_is_initialized){
        return;
    }

    LOG_MSG_DEBUG(LOG_EN, "Processing...");

    switch(app_webserver_state){
        case aws_waiting_for_ready:
        {
            uint32_t wait_events = (APP_WEB_SERVER_WIFI_READY | APP_WEB_SERVER_CONFIG_READY | APP_WEB_SERVER_SPIFFS_READY);
            uint32_t events = hsys_event_group_wait_bits(_app_webserver_events, 
                wait_events,
                pdTRUE, 
                pdTRUE, 
                0
            );

            if(IS_EVENT(events, wait_events)){
                app_webserver_state = aws_running;

                // Start HTTP server
                pal_http_server_config_t server_config = {
                    .port = 80,
                    .max_uri_handlers = 16,
                    .max_open_sockets = 7,
                    .stack_size = 8192,
                    .recv_wait_timeout = 5000,
                    .send_wait_timeout = 5000
                };
                
                int32_t ret = pal_http_server_start(&server_config, &_server);
                if(ret != PAL_OK) {
                    LOG_MSG_ERROR(LOG_EN, "Failed to start HTTP server: %d", ret);
                    return;
                }

                // Register URI handlers
                pal_http_server_register_uri(_server, "/", PAL_HTTP_GET, handle_index, NULL);
                pal_http_server_register_uri(_server, "/styles.css", PAL_HTTP_GET, handle_styles_css, NULL);
                pal_http_server_register_uri(_server, "/deviceConfigurations", PAL_HTTP_GET, 
                                             handle_device_configurations, NULL);
                pal_http_server_register_uri(_server, "/getDeviceConfigurations", PAL_HTTP_GET, 
                                             handle_get_device_configurations, NULL);
                pal_http_server_register_uri(_server, "/setDeviceConfigurationsPost", PAL_HTTP_POST, 
                                             handle_set_device_configurations_post, NULL);
                
                // Register upload handlers for OTA
                pal_http_server_register_uri_with_upload(_server, "/updateFirmwareBin",
                    handle_esp32_firmware_complete, handle_esp32_firmware_upload, NULL);
                
                pal_http_server_register_uri_with_upload(_server, "/updateEsp07FirmwareBin",
                    handle_esp07_firmware_complete, handle_esp07_firmware_upload, NULL);

                LOG_MSG_DEBUG(LOG_EN, "Web Server Ready to Start...");
                _is_server_started = false;
            }
        }
        break;
        case aws_running:
        {
            uint32_t wait_events = (APP_WEB_SERVER_EVENT_CLOUD_READY);
            uint32_t events = hsys_event_group_wait_bits(_app_webserver_events, 
                APP_WEB_SERVER_EVENT_CLOUD_READY,
                pdFALSE, 
                pdFALSE, 
                0
            );

            if(IS_EVENT(events, APP_WEB_SERVER_EVENT_CLOUD_READY) && (!_is_server_started)){
                hsys_event_group_clear_bits(_app_webserver_events, APP_WEB_SERVER_EVENT_CLOUD_READY);
                LOG_MSG_DEBUG(LOG_EN, "Web Server Cloud Ready");

                // Server is already started in waiting_for_ready state
                LOG_MSG_DEBUG(LOG_EN, "Web Server Running...");
                LOG_MSG_DEBUG(LOG_EN, "Web Server Started...");

                _is_server_started = true;
            }
        }
        break;
        default:
        break;
    }   
}

void handle_get_device_configurations(AsyncWebServerRequest *request)
{
	LOG_MSG_DEBUG(LOG_EN, "handle_get_device_configurations");
    String str_json = "";
    int32_t ret_config = app_config_get_config_json(str_json, 1000);
    LOG_MSG_DEBUG(LOG_EN, "Read Config Data %s", str_json.c_str());
	request->send(200, "application/json", str_json.c_str());
}

void handle_set_device_configurations_post(AsyncWebServerRequest* req, uint8_t* data, size_t len, size_t index, size_t total) 
{
	LOG_MSG_DEBUG(LOG_EN, "handle_set_device_configurations_post");
    static String strdata = "";

    if(index==0){
        strdata = "";
    }

    strdata = strdata + String(data, len);

    if(index + len >= total){
        // LOG_MSG_DEBUG(LOG_EN, "Set Config Data %s", strdata.c_str());

		if(total > 2048){
			LOG_MSG_DEBUG(LOG_EN, "Err.. Insuffinet buffer at device config");
			return;
		}
		
        int32_t ret_config = app_config_set_config_json(strdata, 1000);
        if(ret_config == ERROR_OK){       
            if(_on_event != NULL){
                _on_event(APP_WEB_SERVER_EVENT_CONFIG_UPDATED, NULL);
            }            
        }
	}
}

void handle_esp07_firmware_upload(
    AsyncWebServerRequest *request, 
    String filename, 
    size_t index, 
    uint8_t *data, 
    size_t len, 
    bool final) 
{
    int32_t ret = ERROR_OK+1;
    if(aws_cb_table->fp_on_esp07bin_file_received != NULL)
    {
        int32_t ret = aws_cb_table->fp_on_esp07bin_file_received(filename.c_str(), index, data, len, final);
        if(ret != ERROR_OK)
        {
            LOG_MSG_ERROR(LOG_EN, "Error in esp07 firmware upload callback: %d", ret);
        }
    }

    return;
}

const char * esp07_bin_update_get_status_string() {

    if(aws_cb_table->fp_on_esp07bin_file_get_status_string != NULL)
    {
        return aws_cb_table->fp_on_esp07bin_file_get_status_string();
    }
    return "Unknown";
}

void handle_firmware_upload(
    AsyncWebServerRequest *request, 
    String filename, 
    size_t index, 
    uint8_t *data, 
    size_t len, 
    bool final) 
{
    int32_t ret = ERROR_OK+1;
    if(aws_cb_table->fp_on_esp32bin_file_received != NULL)
    {
        int32_t ret = aws_cb_table->fp_on_esp32bin_file_received(filename.c_str(), index, data, len, final);
        if(ret != ERROR_OK)
        {
            LOG_MSG_ERROR(LOG_EN, "Error in firmware upload callback: %d", ret);
        }
    }

    return;
}

const char * esp32_bin_update_get_status_string() {

    if(aws_cb_table->fp_on_esp32bin_file_received != NULL)
    {
        return aws_cb_table->fp_on_esp32bin_file_get_status_string();
    }
    return "Unknown";
}