#include <ArduinoJson.h>

#include "app_common.h"
#include "app_config/app_config.h"

#include "pal_logger.h"
#include "app_mqtt.h"

#include "board.h"

#define __TAG__  "APP_RQST"

extern app_mqtt_request_t * _p_app_mqtt_request_table;
extern uint16_t _app_mqtt_request_table_size;

int32_t _app_request_process(uint32_t request_msg_idx, const char * json_payload, uint8_t *response_payload, uint32_t bytes);
uint32_t _get_request_msg_type_from_json(const char * jason_payload);

int32_t _app_request_generate_response_json(
    const char *request_msg_type,
    const char *data,
    int32_t status,
    uint32_t msg_idx,
    uint8_t *response_json,
    uint32_t bytes)
{
    int32_t ret = ERROR_OK;

    do {
        if (response_json == NULL) {
            ret = ERROR_APP_NULL;
            break;
        }

        const char *status_str = (status == ERROR_OK) ? "Success" : "Failed";

        StaticJsonDocument<512> doc;  // Adjust size as needed

        doc["msg_idx"] = msg_idx;

        char mac_str[32];
        ret = app_config_get_mac_str(mac_str, 500);
        if (ret != ERROR_OK) {
            LOG_MSG_ERROR(LOG_EN, "Failed to get MAC");
            break;
        }

        doc["mac"] = mac_str;

        JsonObject response = doc.createNestedObject("response");
        response["status"] = status_str;
        response["type"] = request_msg_type;
        response["ver"] = "v1.0";

        // Optional "data" parsing
        if ((data != NULL) && (strlen(data) > 0)) {
            StaticJsonDocument<256> temp_data;  // Size depends on your data
            DeserializationError err = deserializeJson(temp_data, data);
            if (err) {
                LOG_MSG_DEBUG(LOG_EN, "Failed to parse input data JSON: %s", err.c_str());
                doc["data"] = "{}";  // Empty JSON object
            }
            else{
                doc["data"] = temp_data.as<JsonObject>();   
            }
        }

        serializeJson(doc, (char *)response_json, bytes);
        LOG_MSG_DEBUG(LOG_EN, "Response : %s", response_json);

    } while (0);

    return ret;
}


uint32_t _get_request_msg_type_from_string(const char * type){

    for(int i=0; i<_app_mqtt_request_table_size; i++){
        if(strncmp(_p_app_mqtt_request_table[i].request_json_name, type, MAX_JSON_NAME_LEN) == 0){
            return (uint32_t)i;
        }
    }

    LOG_MSG_DEBUG(LOG_EN, "Request message type not found %s, %d", type, _app_mqtt_request_table_size);
    return APP_MQTT_REQUEST_MSG_NONE;   
}



int32_t app_mqtt_on_request(const char * payload, uint8_t * response_payload, uint32_t bytes){
    
    int32_t ret;
    uint32_t request_msg_type = _get_request_msg_type_from_json(payload);
    ret = _app_request_process(request_msg_type, payload, response_payload, bytes);
    return ret;
}

uint32_t _get_request_msg_type_from_json(const char * jason_payload){
    
    // Create a JSON document
    JsonDocument doc;
    // Parse the JSON payload
    DeserializationError error = deserializeJson(doc, jason_payload);
    if (error) {
        // Return an error message if parsing fails
        LOG_MSG_DEBUG(LOG_EN, "Error parsing JSON: %s", error.c_str());
        return APP_MQTT_REQUEST_MSG_NONE;
    }

    // Access the "request" object and its "type" field
    if (doc.containsKey("request") && doc["request"].containsKey("type")) {
        return _get_request_msg_type_from_string(doc["request"]["type"].as<const char*>());
    } else {
        // Return an error message if "request" or "type" is missing
        LOG_MSG_DEBUG(LOG_EN, "Missing 'request' or 'type' field in JSON");
        return APP_MQTT_REQUEST_MSG_NONE;
    }
    
    return APP_MQTT_REQUEST_MSG_NONE;
}

int32_t _app_request_process(uint32_t request_msg_idx, const char * json_payload, uint8_t * response_payload, uint32_t bytes){
    
    int32_t ret = ERROR_OK;

    JsonDocument doc;
    DeserializationError error = deserializeJson(doc, json_payload);
    if (error) {
        // Return an error message if parsing fails
        LOG_MSG_DEBUG(LOG_EN, "Error parsing JSON: %s", error.c_str());
        ret = ERROR_APP_INVALID_JSON;
        return ret;
    }
    
    uint32_t msg_idx = doc["msg_idx"];
    JsonObject data = doc["data"];

    switch (request_msg_idx){
        case APP_MQTT_REQUEST_MSG_NONE:
            LOG_MSG_DEBUG(LOG_EN, "Request message type not found");
            ret = ERROR_APP_INVALID_JSON;
            break;
        default:
            if(_p_app_mqtt_request_table[request_msg_idx].on_request){
                char resp_data[_p_app_mqtt_request_table[request_msg_idx].expected_response_max_bytes + 10];
                const char * payload = doc["data"].as<const char*>();
                ret = _p_app_mqtt_request_table[request_msg_idx].on_request(payload, strlen(payload), resp_data);
                _app_request_generate_response_json(
                    _p_app_mqtt_request_table[request_msg_idx].request_json_name, 
                    resp_data, 
                    ret, 
                    msg_idx, 
                    response_payload,
                    bytes
                );
            }
            break;
    }

    return ret;
}