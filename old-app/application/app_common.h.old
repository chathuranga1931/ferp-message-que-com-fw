#ifndef __APP_COMMON_H__
#define __APP_COMMON_H__

#include <stdint.h>
#include <stdbool.h>
#include "user_config.h"
#include "pal_wifi.h"
#include "pal_mqtt.h"

// FreeRTOS constants
#ifndef pdTRUE
#define pdTRUE  1
#endif
#ifndef pdFALSE
#define pdFALSE 0
#endif
#ifndef TRUE
#define TRUE    1
#endif
#ifndef FALSE
#define FALSE   0
#endif

// Error codes
#define ERROR_OK                                    (0)
#define ERROR_APP_NOT_INITIALIZED                   (-1)
#define ERROR_APP_NULL                              (-2)
#define ERROR_APP_BUSY                              (-3)
#define ERROR_APP_SPIFF_NO_FILE                     (-4)
#define ERROR_APP_CLOUD_INVALID_MAC_ADDRESS         (-5)
#define ERROR_APP_CLOUD_NO_NONCE                    (-6)
#define ERROR_APP_CLOUD_GET_AGENT_CONFIG_FAILED     (-7)
#define ERROR_APP_CLOUD_GET_NOZZLE_CONFIG_FAILED    (-8)
#define ERROR_APP_INVALID_JSON                      (-9)
#define ERROR_APP_INVALID_ARGUMENTS                 (-10)

// WiFi configuration - use value from user_config.h
#ifndef USER_MAX_NO_WIFI_CONNECT_RETRY_COUNT
#define USER_MAX_NO_WIFI_CONNECT_RETRY_COUNT        (5)
#endif
#define WIFI_MODE_STATION                           (0)
#define WIFI_MODE_ACCESSPOINT                       (1)

// Legacy WiFi structure for compatibility
typedef struct{
    uint32_t mode;
    char ssid[64];
    char password[64];
    uint8_t rssi_no_levels;
}hsys_wifi_init_t;

// MQTT structure for legacy compatibility
typedef struct {
    char broker_url[128];
    uint16_t port;
    char client_id[64];
    char username[64];
    char password[64];
    uint16_t keepalive;
}hsys_mqtt_init_t;

// Printer configs structure
typedef struct {
    char url[128];
    uint32_t print_copy_count;
    uint32_t print_delay_ms;
}printer_configs_t;

// Logging structure
typedef struct {
    bool serial_log_enabled;
    uint32_t serial_log_level;
    bool udp_log_enabled;
    uint32_t udp_log_level;
    char udp_server_ip[16];
    uint32_t udp_server_port;
}app_logging_t;

// App configuration structure
typedef struct {
    hsys_wifi_init_t wifi;
    app_settings_init_t app;
    printer_configs_t printer;
    hsys_mqtt_init_t mqtt;
    app_logging_t logging;
    char group[32];
}app_config_t;

// Event types
typedef enum{
    // WiFi events from PAL layer (aligned with pal_wifi_event_t)
    APP_WIFI_EVENT_STA_START = 0,
    APP_WIFI_EVENT_STA_CONNECTED,
    APP_WIFI_EVENT_STA_DISCONNECTED,
    APP_WIFI_EVENT_STA_GOT_IP,
    APP_WIFI_EVENT_AP_START,
    APP_WIFI_EVENT_AP_STOP,
    APP_WIFI_EVENT_AP_STACONNECTED,
    APP_WIFI_EVENT_AP_STADISCONNECTED,
    
    // Application-specific WiFi events
    APP_WIFI_EVENT_NO_AVAILABLE_SIGNAL,
}app_wifi_event_t;

typedef enum{
    APP_CONFIG_EVENT_LOADED,
}app_config_event_t;

typedef enum{
    APP_INTERNET_EVENT_CONNECTED,
    APP_INTERNET_EVENT_DISCONNECTED,
}app_internet_event_t;

typedef enum{
    APP_SPIFFS_EVNT_SPIFFS_READY,
}app_spiffs_event_t;

typedef enum {
    APP_MQTT_EVENT_ON_CONNECT = 0,
    APP_MQTT_EVENT_ON_DISCONNECT,
    APP_MQTT_EVENT_NONE,
}app_mqtt_event_t;

// MQTT configuration constants
#define APP_MQTT_SUBTOPIC_MAX_SIZE          (128)

// Function pointer types
typedef void (*fp_wake_task_t)(void * arg);
typedef void (*fp_app_wifi_on_event_t)(app_wifi_event_t event, void * arg);
typedef void (*fp_app_config_on_event_t)(app_config_event_t event, void * arg);
typedef void (*fp_app_internet_on_event_t)(app_internet_event_t event, void * arg);
typedef void (*fp_app_spiffs_on_event_t)(app_spiffs_event_t event, void * arg);
typedef void (*fp_app_mqtt_on_event_t)(app_mqtt_event_t event, void * arg);
typedef int32_t (*fp_on_mqtt_msg_t)(const uint8_t * payload, uint16_t payload_len);
typedef const char * (*fp_get_mqtt_sub_topic_t)(uint8_t idx, char * path, fp_on_mqtt_msg_t * callback);

// Event table structure
typedef struct{
    fp_app_wifi_on_event_t on_wifi_event;
    fp_app_config_on_event_t on_config_event;
    fp_app_internet_on_event_t on_internet_event;
    fp_app_spiffs_on_event_t on_spiffs_event;
    // Add other event handlers as needed
}event_table_t;

// App initialization structure
typedef struct {
    event_table_t * event_table;
    fp_wake_task_t fp_wake;
    void * wake_context;
}app_init_t;

#endif // __APP_COMMON_H__
